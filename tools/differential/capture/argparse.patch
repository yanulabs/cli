+  std::string diff_parser_json(
+      const ArgumentParser &p,
+      const std::vector<const ArgumentParser *> &order) const {
+    auto index_in_order = [&](const ArgumentParser *q) -> long {
+      auto it = std::find(order.begin(), order.end(), q);
+      if (it == order.end()) {
+        return -1;
+      }
+      return static_cast<long>(std::distance(order.begin(), it));
+    };
+    auto index_of_argument = [&](const Argument *needle) -> long {
+      std::size_t i = 0;
+      for (const auto &a : p.m_positional_arguments) {
+        if (&a == needle) {
+          return static_cast<long>(i);
+        }
+        ++i;
+      }
+      for (const auto &a : p.m_optional_arguments) {
+        if (&a == needle) {
+          return static_cast<long>(i);
+        }
+        ++i;
+      }
+      return -1;
+    };
+
+    std::ostringstream o;
+    o << "{\"program\":" << diff_escape(p.m_program_name);
+    o << ",\"parser_path\":" << diff_escape(p.m_parser_path);
+    o << ",\"prefix\":" << diff_escape(p.m_prefix_chars);
+    o << ",\"assign\":" << diff_escape(p.m_assign_chars);
+    o << ",\"suppress\":" << (p.m_suppress ? "true" : "false");
+    o << ",\"group_names\":[";
+    for (std::size_t i = 0; i < p.m_group_names.size(); ++i) {
+      o << (i ? "," : "") << diff_escape(p.m_group_names[i]);
+    }
+    o << "],\"positionals\":[";
+    std::size_t idx = 0;
+    for (const auto &a : p.m_positional_arguments) {
+      o << (idx ? "," : "") << diff_argument_json(a, idx);
+      ++idx;
+    }
+    o << "],\"optionals\":[";
+    bool first_opt = true;
+    for (const auto &a : p.m_optional_arguments) {
+      if (!first_opt) {
+        o << ",";
+      }
+      first_opt = false;
+      o << diff_argument_json(a, idx);
+      ++idx;
+    }
+    o << "],\"mutex\":[";
+    for (std::size_t i = 0; i < p.m_mutually_exclusive_groups.size(); ++i) {
+      const auto &group = p.m_mutually_exclusive_groups[i];
+      o << (i ? "," : "") << "{\"required\":"
+        << (group.m_required ? "true" : "false") << ",\"elements\":[";
+      for (std::size_t j = 0; j < group.m_elements.size(); ++j) {
+        o << (j ? "," : "") << index_of_argument(group.m_elements[j]);
+      }
+      o << "]}";
+    }
+    o << "],\"hidden_aliases\":[";
+    bool first_alias = true;
+    for (const auto &[name, arg_it] : p.m_argument_map) {
+      const auto &names = arg_it->m_names;
+      if (std::find(names.begin(), names.end(), name) != names.end()) {
+        continue;
+      }
+      if (!first_alias) {
+        o << ",";
+      }
+      first_alias = false;
+      o << "[" << diff_escape(name) << ","
+        << diff_escape(names.empty() ? std::string{} : names.front()) << "]";
+    }
