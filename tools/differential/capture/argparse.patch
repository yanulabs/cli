+private:
+  static std::string diff_escape(const std::string &s) {
+    std::ostringstream out;
+    out << '"';
+    for (unsigned char c : s) {
+      switch (c) {
+      case '"':
+        out << "\\\"";
+        break;
+      case '\\':
+        out << "\\\\";
+        break;
+      case '\b':
+        out << "\\b";
+        break;
+      case '\f':
+        out << "\\f";
+        break;
+      case '\n':
+        out << "\\n";
+        break;
+      case '\r':
+        out << "\\r";
+        break;
+      case '\t':
+        out << "\\t";
+        break;
+      default:
+        if (c < 0x20 || c >= 0x7f) {
+          out << "\\u" << std::hex << std::setw(4) << std::setfill('0')
+              << static_cast<unsigned>(c) << std::dec;
+        } else {
+          out << static_cast<char>(c);
+        }
+      }
+    }
+    out << '"';
+    return out.str();
+  }
+
+  static std::string diff_hex(const std::string &s) {
+    static constexpr char digits[] = "0123456789abcdef";
+    std::string out;
+    out.reserve(s.size() * 2);
+    for (unsigned char c : s) {
+      out.push_back(digits[c >> 4]);
+      out.push_back(digits[c & 0x0f]);
+    }
+    return out;
+  }
+
+  static std::string diff_any_repr(const std::any &a) {
+    if (!a.has_value()) {
+      return {};
+    }
+    if (a.type() == typeid(bool)) {
+      return std::any_cast<bool>(a) ? "true" : "false";
+    }
+    if (a.type() == typeid(int)) {
+      return std::to_string(std::any_cast<int>(a));
+    }
+    if (a.type() == typeid(unsigned)) {
+      return std::to_string(std::any_cast<unsigned>(a));
+    }
+    if (a.type() == typeid(long)) {
+      return std::to_string(std::any_cast<long>(a));
+    }
+    if (a.type() == typeid(std::string)) {
+      return std::any_cast<const std::string &>(a);
+    }
+    if (a.type() == typeid(const char *)) {
+      return std::any_cast<const char *>(a);
+    }
+    return {};
+  }
+
+  template <typename T>
+  static std::string diff_float_text(const T &value) {
+    std::ostringstream out;
+    out.imbue(std::locale::classic());
+    out << std::setprecision(std::numeric_limits<T>::max_digits10) << value;
+    return out.str();
+  }
+
+  template <typename T>
+  static std::string diff_scalar_json(const T &value) {
+    if constexpr (std::is_same_v<T, bool>) {
+      return value ? "{\"kind\":\"bool\",\"value\":true}"
+                   : "{\"kind\":\"bool\",\"value\":false}";
+    } else if constexpr (std::is_same_v<T, std::string>) {
+      return "{\"kind\":\"string\",\"value\":" + diff_escape(value) + "}";
+    } else if constexpr (std::is_floating_point_v<T>) {
+      return "{\"kind\":\"float\",\"value\":"
+             + diff_escape(diff_float_text(value)) + "}";
+    } else if constexpr (std::is_same_v<T, char> ||
+                         std::is_same_v<T, signed char> ||
+                         std::is_same_v<T, unsigned char>) {
+      return "{\"kind\":\"char\",\"value\":"
+             + std::to_string(static_cast<long long>(value)) + "}";
+    } else if constexpr (std::is_signed_v<T>) {
+      return "{\"kind\":\"signed\",\"value\":"
+             + diff_escape(std::to_string(value)) + "}";
+    } else {
+      return "{\"kind\":\"unsigned\",\"value\":"
+             + diff_escape(std::to_string(value)) + "}";
+    }
+  }
+
+  template <typename T>
+  static std::string diff_vector_json(const std::vector<T> &values) {
+    std::string out = "{\"kind\":\"vector\",\"values\":[";
+    bool first = true;
+    for (const auto &value : values) {
+      if (!first) {
+        out += ',';
+      }
+      first = false;
+      out += diff_scalar_json(value);
+    }
+    return out + "]}";
+  }
+
+  template <typename T>
+  static std::string diff_any_scalar(const std::any &a) {
+    if (a.type() != typeid(T)) {
+      return {};
+    }
+    return diff_scalar_json(std::any_cast<const T &>(a));
+  }
+
+  template <typename T>
+  static std::string diff_any_vector(const std::any &a) {
+    if (a.type() != typeid(std::vector<T>)) {
+      return {};
+    }
+    return diff_vector_json(std::any_cast<const std::vector<T> &>(a));
+  }
+
+  static std::string diff_any_value_json(const std::any &a) {
+    if (!a.has_value()) {
+      return "{\"kind\":\"unsupported\",\"type_id\":\"\"}";
+    }
+    std::string out;
+    out = diff_any_scalar<bool>(a); if (!out.empty()) return out;
+    out = diff_any_scalar<std::string>(a); if (!out.empty()) return out;
+    out = diff_any_scalar<char>(a); if (!out.empty()) return out;
+    out = diff_any_scalar<signed char>(a); if (!out.empty()) return out;
+    out = diff_any_scalar<unsigned char>(a); if (!out.empty()) return out;
+    out = diff_any_scalar<short>(a); if (!out.empty()) return out;
+    out = diff_any_scalar<unsigned short>(a); if (!out.empty()) return out;
+    out = diff_any_scalar<int>(a); if (!out.empty()) return out;
+    out = diff_any_scalar<unsigned>(a); if (!out.empty()) return out;
+    out = diff_any_scalar<long>(a); if (!out.empty()) return out;
+    out = diff_any_scalar<unsigned long>(a); if (!out.empty()) return out;
+    out = diff_any_scalar<long long>(a); if (!out.empty()) return out;
+    out = diff_any_scalar<unsigned long long>(a); if (!out.empty()) return out;
+    out = diff_any_scalar<float>(a); if (!out.empty()) return out;
+    out = diff_any_scalar<double>(a); if (!out.empty()) return out;
+    out = diff_any_scalar<long double>(a); if (!out.empty()) return out;
+    out = diff_any_vector<std::string>(a); if (!out.empty()) return out;
+    out = diff_any_vector<int>(a); if (!out.empty()) return out;
+    if (a.type() == typeid(const char *)) {
+      return "{\"kind\":\"string\",\"value\":"
+             + diff_escape(std::any_cast<const char *>(a)) + "}";
+    }
+    return "{\"kind\":\"unsupported\",\"type_id\":"
+           + diff_escape(std::string(a.type().name())) + "}";
+  }
+
+  std::string diff_argument_values_json(const Argument &a) const {
+    if (!a.m_is_used) {
+      return {};
+    }
+    std::string results = "[";
+    if (!a.m_values.empty()) {
+      const auto last = diff_any_value_json(a.m_values.back());
+      const bool container_snapshot = last.rfind("{\"kind\":\"vector\"", 0) == 0;
+      const bool multiple = a.m_is_repeatable ||
+                            a.m_num_args_range.get_max() > 1 ||
+                            a.m_num_args_range.get_max() ==
+                              (std::numeric_limits<std::size_t>::max)();
+      if (container_snapshot) {
+        results += last;
+      } else {
+        bool first = true;
+        const auto count = multiple ? a.m_values.size() : 1;
+        for (std::size_t i = 0; i < count; ++i) {
+          const auto &value = a.m_values[multiple ? i : a.m_values.size() - 1];
+          if (!first) {
+            results += ',';
+          }
+          first = false;
+          results += diff_any_value_json(value);
+        }
+      }
+    }
+    results += "]";
+    return "{\"used\":true,\"results\":" + results + "}";
+  }
+
+  std::string diff_values_json() const {
+    std::vector<const ArgumentParser *> order;
+    diff_collect_parsers(*this, order);
+    std::ostringstream out;
+    out << '[';
+    bool first_entry = true;
+    for (std::size_t parser_index = 0; parser_index < order.size(); ++parser_index) {
+      const auto &parser = *order[parser_index];
+      std::size_t argument_index = 0;
+      auto emit = [&](const Argument &a) {
+        if (a.m_diff_builtin || !a.m_is_used) {
+          return;
+        }
+        const auto values = diff_argument_values_json(a);
+        if (values.empty()) {
+          return;
+        }
+        if (!first_entry) {
+          out << ',';
+        }
+        first_entry = false;
+        out << "{\"parser\":" << parser_index
+            << ",\"argument\":" << argument_index << ",\"values\":" << values << '}';
+      };
+      for (const auto &a : parser.m_positional_arguments) {
+        emit(a);
+        ++argument_index;
+      }
+      for (const auto &a : parser.m_optional_arguments) {
+        emit(a);
+        ++argument_index;
+      }
+    }
+    out << ']';
+    return out.str();
+  }
