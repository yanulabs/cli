+inline std::string
+esc(const std::string& s)
+{
+  std::string out;
+  out.reserve(s.size() + 8);
+  for (unsigned char c : s)
+  {
+    switch (c)
+    {
+      case '"': out += "\\\""; break;
+      case '\\': out += "\\\\"; break;
+      case '\n': out += "\\n"; break;
+      case '\r': out += "\\r"; break;
+      case '\t': out += "\\t"; break;
+      default:
+        if (c < 0x20 || c >= 0x7f)
+        {
+          char buf[8];
+          std::snprintf(buf, sizeof(buf), "\\u%04x", c);
+          out += buf;
+        }
+        else
+        {
+          out += static_cast<char>(c);
+        }
+    }
+  }
+  return out;
+}
+
+template <typename T>
+struct is_std_vector : std::false_type {};
+
+template <typename T, typename A>
+struct is_std_vector<std::vector<T, A>> : std::true_type {};
+
+template <typename T>
+inline std::string
+float_text(const T& value)
+{
+  std::ostringstream out;
+  out.imbue(std::locale::classic());
+  out << std::setprecision(std::numeric_limits<T>::max_digits10) << value;
+  return out.str();
+}
+
+inline std::string
+value_json(bool value)
+{
+  return value ? "{\"kind\":\"bool\",\"value\":true}"
+               : "{\"kind\":\"bool\",\"value\":false}";
+}
+
+inline std::string
+value_json(const std::string& value)
+{
+  return "{\"kind\":\"string\",\"value\":\"" + esc(value) + "\"}";
+}
+
+template <typename T>
+inline typename std::enable_if<std::is_floating_point<T>::value, std::string>::type
+value_json(const T& value)
+{
+  return "{\"kind\":\"float\",\"value\":\"" + float_text(value) + "\"}";
+}
+
+template <typename T>
+inline typename std::enable_if<
+  std::is_integral<T>::value && !std::is_same<T, bool>::value
+  && !std::is_same<T, char>::value && !std::is_same<T, signed char>::value
+  && !std::is_same<T, unsigned char>::value, std::string>::type
+value_json(const T& value)
+{
+  if (std::is_signed<T>::value)
+  {
+    return "{\"kind\":\"signed\",\"value\":\"" + std::to_string(value) + "\"}";
+  }
+  return "{\"kind\":\"unsigned\",\"value\":\"" + std::to_string(value) + "\"}";
+}
+
+template <typename T>
+inline typename std::enable_if<
+  std::is_same<T, char>::value || std::is_same<T, signed char>::value
+  || std::is_same<T, unsigned char>::value, std::string>::type
+value_json(const T& value)
+{
+  return "{\"kind\":\"char\",\"value\":"
+         + std::to_string(static_cast<long long>(value)) + "}";
+}
+
+template <typename T>
+inline typename std::enable_if<
+  !std::is_arithmetic<T>::value && !std::is_same<T, std::string>::value
+  && !is_std_vector<T>::value, std::string>::type
+value_json(const T&)
+{
+  return "{\"kind\":\"unsupported\",\"type_id\":\""
+         + esc(typeid(T).name()) + "\"}";
+}
+
+template <typename T, typename A>
+inline std::string
+value_json(const std::vector<T, A>& values)
+{
+  std::string out = "{\"kind\":\"vector\",\"values\":[";
+  bool first = true;
+  for (const auto& element : values)
+  {
+    if (!first) out += ',';
+    first = false;
+    out += value_json(element);
+  }
+  return out + "]}";
+}
