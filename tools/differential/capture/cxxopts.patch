+inline std::string
+Options::diff_schema() const
+{
+  std::string out = "{\"program\":\"" + diff::esc(m_program) + "\"";
+  out += ",\"allow_unrecognised\":";
+  out += m_allow_unrecognised ? "true" : "false";
+  out += ",\"positional\":[";
+  bool first = true;
+  for (const auto& pos : m_positional)
+  {
+    if (!first) out += ',';
+    first = false;
+    out += '"' + diff::esc(pos) + '"';
+  }
+  out += "],\"options\":[";
+  std::unordered_set<const OptionDetails*> seen;
+  first = true;
+  for (const auto& entry : *m_options)
+  {
+    const auto& detail = *entry.second;
+    if (!seen.insert(entry.second.get()).second)
+    {
+      continue;
+    }
+    if (!first) out += ',';
+    first = false;
+    out += "{\"short\":\"" + diff::esc(detail.short_name()) + "\"";
+    out += ",\"long\":[";
+    bool first_long = true;
+    for (const auto& name : detail.long_names())
+    {
+      if (!first_long) out += ',';
+      first_long = false;
+      out += '"' + diff::esc(name) + '"';
+    }
+    out += "]";
+    out += ",\"desc\":\"" + diff::esc(detail.description()) + "\"";
+    const auto& value = detail.value();
+    out += ",\"is_boolean\":";
+    out += value.is_boolean() ? "true" : "false";
+    out += ",\"is_container\":";
+    out += value.is_container() ? "true" : "false";
+    out += ",\"has_default\":";
+    out += value.has_default() ? "true" : "false";
+    out += ",\"default\":\"" + diff::esc(value.get_default_value()) + "\"";
+    out += ",\"has_implicit\":";
+    out += value.has_implicit() ? "true" : "false";
+    out += ",\"implicit\":\"" + diff::esc(value.get_implicit_value()) + "\"";
+    out += ",\"type_id\":\"" + diff::esc(value.diff_type_id()) + "\"}";
+  }
+  out += "]}";
+  return out;
+}
